---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found">
  <div class="max-w-3xl mx-auto px-6 pt-32 pb-16 text-center">
    <h1 class="font-serif text-6xl font-normal text-foreground mb-4">404</h1>
    <p class="text-lg text-muted-foreground mb-8">This page doesn't exist.</p>
    <div class="flex items-center justify-center gap-3">
      <a
        href="/"
        class="px-6 py-2.5 bg-foreground text-background font-medium rounded-full text-sm transition-all duration-200 hover:opacity-90"
      >
        Go home
      </a>
      <a
        href="/blog"
        class="px-6 py-2.5 border border-border text-foreground font-medium rounded-full text-sm transition-all duration-200 hover:bg-muted"
      >
        Read blog
      </a>
    </div>
  </div>
</BaseLayout>
