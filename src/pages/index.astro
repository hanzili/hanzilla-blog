---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';

// Get latest blog posts (non-draft, sorted by date)
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// Projects data
const projects = [
  {
    title: 'jobs.hanzilla.co',
    description: 'Tech job board for new grads in Canada.',
    href: 'https://jobs.hanzilla.co',
    icon: '💼',
    tags: ['Python', 'Astro']
  }
];
---

<BaseLayout title="Home">
  <!-- Hero Section -->
  <Hero />

  <!-- Projects Section -->
  <section id="projects" class="max-w-5xl mx-auto px-6 py-16">
    <div class="mb-10">
      <h2 class="text-3xl font-bold text-gray-100 mb-3">
        Projects
      </h2>
      <p class="text-gray-400">
        Things I've built and am currently working on.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      {projects.map(project => (
        <ProjectCard {...project} />
      ))}
    </div>
  </section>

  <!-- Latest Posts Section -->
  <section class="max-w-5xl mx-auto px-6 py-16">
    <div class="flex items-center justify-between mb-10">
      <div>
        <h2 class="text-3xl font-bold text-gray-100 mb-3">
          Latest Posts
        </h2>
        <p class="text-gray-400">
          Thoughts on tech, career, and life.
        </p>
      </div>
      <a
        href="/blog"
        class="text-yellow-400 hover:text-yellow-500 font-medium link-underline"
      >
        View all →
      </a>
    </div>

    {latestPosts.length > 0 ? (
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {latestPosts.map(post => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={post.slug}
            heroImage={post.data.heroImage}
          />
        ))}
      </div>
    ) : (
      <p class="text-gray-500 text-center py-12">
        No posts yet. Check back soon!
      </p>
    )}
  </section>

  <!-- Contact / CTA Section -->
  <section class="max-w-5xl mx-auto px-6 py-16">
    <div class="bg-gradient-to-r from-gray-800 to-gray-800/50 border border-gray-700 rounded-2xl p-8 md:p-12 text-center">
      <h2 class="text-2xl md:text-3xl font-bold text-gray-100 mb-4">
        Let's Connect
      </h2>
      <p class="text-gray-400 mb-8 max-w-lg mx-auto">
        Feel free to reach out!
      </p>
      <div class="flex items-center justify-center gap-4">
        <a
          href="https://github.com/hanzili"
          target="_blank"
          rel="noopener noreferrer"
          class="p-4 bg-gray-700 hover:bg-yellow-400 text-gray-300 hover:text-gray-900 rounded-xl transition-all hover:shadow-lg hover:shadow-yellow-400/25"
          aria-label="GitHub"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
        </a>
        <a
          href="https://www.linkedin.com/in/hanzi-li-mcgill/"
          target="_blank"
          rel="noopener noreferrer"
          class="p-4 bg-gray-700 hover:bg-yellow-400 text-gray-300 hover:text-gray-900 rounded-xl transition-all hover:shadow-lg hover:shadow-yellow-400/25"
          aria-label="LinkedIn"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
        </a>
        <a
          href="https://x.com/hanzi_li"
          target="_blank"
          rel="noopener noreferrer"
          class="p-4 bg-gray-700 hover:bg-yellow-400 text-gray-300 hover:text-gray-900 rounded-xl transition-all hover:shadow-lg hover:shadow-yellow-400/25"
          aria-label="X"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
