---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';

// Get latest blog posts (non-draft, sorted by date)
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// Projects data
const projects = [
  {
    title: 'Hanzi Browse',
    description: 'Give your AI agent a real browser. One setup command, works with Claude Code, Cursor, Codex, and 10+ agents.',
    href: 'https://browse.hanzilla.co',
    tags: ['AI', 'MCP', 'Browser Automation']
  },
  {
    title: 'SkipLec',
    description: 'AI-powered tool that turns lecture recordings and slides into complete study notes in minutes.',
    href: 'https://skiplec.com',
    tags: ['AI', 'EdTech']
  },
  {
    title: 'jobs.hanzilla.co',
    description: 'Job board for university students in Canada.',
    href: 'https://jobs.hanzilla.co',
    tags: ['Python', 'Astro']
  }
];
---

<BaseLayout title="Home">
  <!-- Hero Section -->
  <Hero />

  <!-- Projects Section -->
  <section id="projects" class="max-w-5xl mx-auto px-6 py-16">
    <div class="mb-10">
      <h2 class="font-serif text-3xl font-normal text-foreground mb-3">
        Projects
      </h2>
      <p class="text-muted-foreground">
        Things I've built and am currently working on.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      {projects.map(project => (
        <ProjectCard {...project} />
      ))}
    </div>
  </section>

  <!-- Latest Posts Section -->
  <section class="max-w-5xl mx-auto px-6 py-16">
    <div class="flex items-center justify-between mb-10">
      <div>
        <h2 class="font-serif text-3xl font-normal text-foreground mb-3">
          Latest Posts
        </h2>
        <p class="text-muted-foreground">
          Thoughts on tech, career, and life.
        </p>
      </div>
      <a
        href="/blog"
        class="text-primary hover:opacity-70 font-medium text-sm link-underline"
      >
        View all
      </a>
    </div>

    {latestPosts.length > 0 ? (
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {latestPosts.map(post => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={post.slug}
            heroImage={post.data.heroImage}
          />
        ))}
      </div>
    ) : (
      <p class="text-muted-foreground text-center py-12">
        No posts yet. Check back soon!
      </p>
    )}
  </section>

  <!-- CTA Section -->
  <section class="max-w-5xl mx-auto px-6 py-16">
    <div class="bg-card ring-1 ring-foreground/[0.065] shadow-lg shadow-foreground/5 dark:shadow-black/10 rounded-2xl p-8 md:p-12 text-center">
      <h2 class="font-serif text-2xl md:text-3xl font-normal text-foreground mb-4">
        Give your AI agent a real browser
      </h2>
      <p class="text-muted-foreground mb-8 max-w-lg mx-auto">
        One command. Works with Claude Code, Cursor, Codex, and more.
      </p>
      <a
        href="https://browse.hanzilla.co"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block px-6 py-2.5 bg-foreground text-background font-medium rounded-full text-sm transition-all duration-200 hover:opacity-90 active:scale-[0.99]"
      >
        Try Hanzi Browse
      </a>
    </div>
  </section>
</BaseLayout>
