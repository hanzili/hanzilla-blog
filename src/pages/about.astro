---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About"
  description="Learn more about Hanzi."
>
  <div class="max-w-3xl mx-auto px-6 pt-32 pb-16">
    <!-- Header -->
    <header class="mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-100 mb-6 tracking-tight">
        About Me
      </h1>
    </header>

    <!-- Content -->
    <div class="prose prose-lg">
      <p>
        Hi! I'm <strong>Hanzi</strong> 👋
      </p>

      <p>
        I'm a builder interested in startups and tech.
      </p>

      <h2>Get in Touch</h2>

      <ul>
        <li><a href="https://github.com/hanzili">GitHub</a></li>
        <li><a href="https://www.linkedin.com/in/hanzi-li-mcgill/">LinkedIn</a></li>
        <li><a href="https://x.com/hanzi_li">X</a></li>
      </ul>

      <p>
        Also check out <a href="https://jobs.hanzilla.co">jobs.hanzilla.co</a>.
      </p>
    </div>
  </div>
</BaseLayout>
