---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  prevPost?: CollectionEntry<'blog'> | null;
  nextPost?: CollectionEntry<'blog'> | null;
}

const { post, prevPost, nextPost } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage } = post.data;

// Calculate reading time (rough estimate: 200 words per minute)
const content = post.body || '';
const words = content.split(/\s+/).length;
const readingTime = Math.ceil(words / 200);

const formattedDate = new Date(pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

const formattedUpdatedDate = updatedDate
  ? new Date(updatedDate).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    })
  : null;
---

<BaseLayout title={title} description={description} image={heroImage} type="article" pubDate={pubDate} updatedDate={updatedDate} tags={post.data.tags}>
  <article class="max-w-3xl mx-auto px-6 py-16">
    <!-- Header -->
    <header class="mb-12">
      <div class="flex items-center gap-3 text-muted-foreground text-sm mb-4">
        <time datetime={pubDate.toISOString()}>
          {formattedDate}
        </time>
        <span>·</span>
        <span>{readingTime} min read</span>
      </div>

      <h1 class="text-balance font-serif text-4xl md:text-5xl font-normal text-foreground mb-6 leading-tight">
        {title}
      </h1>

      {description && (
        <p class="text-lg text-muted-foreground leading-relaxed">
          {description}
        </p>
      )}

      {updatedDate && (
        <p class="text-sm text-muted-foreground mt-4">
          Last updated on {formattedUpdatedDate}
        </p>
      )}
    </header>

    <!-- Hero Image -->
    {heroImage && (
      <div class="mb-12 rounded-2xl overflow-hidden">
        <img
          src={heroImage}
          alt={title}
          class="w-full h-auto"
          transition:name={`hero-${post.slug}`}
        />
      </div>
    )}

    <!-- Content -->
    <div class="prose prose-lg">
      <slot />
    </div>

    <!-- Post Navigation -->
    {(prevPost || nextPost) && (
      <nav class="mt-16 pt-8 border-t border-border grid grid-cols-2 gap-6">
        {prevPost ? (
          <a href={`/blog/${prevPost.slug}`} class="group">
            <span class="text-xs text-muted-foreground">Older</span>
            <p class="font-serif text-foreground group-hover:text-primary transition-colors mt-1">{prevPost.data.title}</p>
          </a>
        ) : <div />}
        {nextPost ? (
          <a href={`/blog/${nextPost.slug}`} class="group text-right">
            <span class="text-xs text-muted-foreground">Newer</span>
            <p class="font-serif text-foreground group-hover:text-primary transition-colors mt-1">{nextPost.data.title}</p>
          </a>
        ) : <div />}
      </nav>
    )}

    <!-- Footer -->
    <footer class="mt-8 pt-8 border-t border-border">
      <a
        href="/blog"
        class="inline-flex items-center gap-2 text-primary hover:opacity-70 transition-opacity link-underline"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m15 18-6-6 6-6"/>
        </svg>
        Back to all posts
      </a>
    </footer>
  </article>
</BaseLayout>
