---
interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Hi, I'm Hanzi",
  subtitle = "I build things on the internet."
} = Astro.props;
---

<section class="relative min-h-[60vh] flex items-center justify-center px-6 pt-24 pb-16">
  <div class="relative max-w-xl text-center">
    <!-- Main title -->
    <h1 class="text-balance font-serif text-5xl md:text-6xl font-normal text-foreground mb-6 animate-on-load animate-fade-in-up stagger-1">
      {title}
    </h1>

    <!-- Subtitle -->
    <p class="text-lg text-muted-foreground mb-10 text-balance animate-on-load animate-fade-in-up stagger-2">
      {subtitle}
    </p>

    <!-- CTA Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 animate-on-load animate-fade-in-up stagger-3">
      <a
        href="#projects"
        class="px-6 py-2.5 bg-foreground text-background font-medium rounded-full text-sm transition-all duration-200 hover:opacity-90 active:scale-[0.99]"
      >
        View Projects
      </a>
      <a
        href="/blog"
        class="px-6 py-2.5 border border-border text-foreground font-medium rounded-full text-sm transition-all duration-200 hover:bg-muted active:scale-[0.99]"
      >
        Read Blog
      </a>
    </div>

    <!-- Status -->
    <div class="mt-16 flex items-center justify-center gap-2 text-sm text-muted-foreground animate-on-load animate-fade-in stagger-4">
      <span class="w-1.5 h-1.5 bg-green-500 rounded-full animate-pulse"></span>
      <span>Available for projects</span>
    </div>
  </div>
</section>

<style>
  .animate-on-load {
    animation-fill-mode: both;
  }
</style>
