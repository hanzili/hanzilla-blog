---
interface Props {
  title: string;
  description: string;
  href: string;
  icon?: string;
  tags?: string[];
  isExternal?: boolean;
}

const {
  title,
  description,
  href,
  icon = '🚀',
  tags = [],
  isExternal = true
} = Astro.props;
---

<a
  href={href}
  target={isExternal ? '_blank' : '_self'}
  rel={isExternal ? 'noopener noreferrer' : undefined}
  class="group block p-6 bg-gray-800 border border-gray-700 rounded-xl card-hover"
>
  <div class="flex items-start gap-4">
    <!-- Icon -->
    <div class="text-3xl flex-shrink-0" aria-hidden="true">
      {icon}
    </div>

    <div class="flex-1 min-w-0">
      <!-- Title with arrow -->
      <h3 class="text-lg font-semibold text-gray-100 group-hover:text-yellow-400 transition-colors flex items-center gap-2">
        {title}
        <svg
          class="w-4 h-4 text-gray-500 group-hover:text-yellow-400 group-hover:translate-x-1 transition-all"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12h14"/>
          <path d="m12 5 7 7-7 7"/>
        </svg>
      </h3>

      <!-- Description -->
      <p class="text-gray-400 text-sm mt-2 leading-relaxed">
        {description}
      </p>

      <!-- Tags -->
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-4">
          {tags.map(tag => (
            <span class="px-2 py-1 text-xs bg-gray-700 text-gray-300 rounded-md">
              {tag}
            </span>
          ))}
        </div>
      )}
    </div>
  </div>
</a>
